<!-- -*- mode: XML -*- -->
<launch>
  <arg name="mpc_config_filename" default="mpc_params.yaml"/>
  <param name="mpc_config_filename" value="$(arg mpc_config_filename)"/>

  <!-- Launch Acados MPC controller -->
  <node pkg="controller" type="mpc_controller.py" name="mpc_ros_simulator" output="screen"/>
</launch>
